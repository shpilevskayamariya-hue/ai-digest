---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Serialize only the fields Fuse.js needs — injected as JSON into the page
const searchData = posts.map((p) => ({
	id: p.id,
	title: p.data.title,
	description: p.data.description,
	tags: p.data.tags,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			/* Featured card — same rules as :first-child, but managed by JS after sort/filter */
			ul li.featured {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li.featured img { width: 100%; }
			ul li.featured .title { font-size: 2.369rem; }
			/* Sort button bar */
			.sort-controls {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin-bottom: 1.5rem;
				flex-wrap: wrap;
			}
			.sort-label {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.sort-btn {
				padding: 0.3em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 20px;
				background: none;
				font-size: 0.85em;
				color: rgb(var(--gray-dark));
				cursor: pointer;
				transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
			}
			.sort-btn:hover { border-color: var(--accent); color: var(--accent); }
			.sort-btn.active { background: var(--accent); border-color: var(--accent); color: white; }
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
				ul li.featured .title { font-size: 1.563em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<!-- Fuse.js search index — not rendered, just parsed by the script below -->
				<script id="search-data" type="application/json" set:html={JSON.stringify(searchData)} />
				<!-- Sort controls — "newest" is active by default to match server-side sort order -->
				<div class="sort-controls">
					<span class="sort-label">Sort:</span>
					<button class="sort-btn active" data-sort="newest">Newest</button>
					<button class="sort-btn" data-sort="oldest">Oldest</button>
					<button class="sort-btn" data-sort="az">A→Z</button>
					<button class="sort-btn" data-sort="za">Z→A</button>
				</div>
				<ul>
					{
						posts.map((post) => (
							/* data-post-id, data-title, data-pub-date let the script sort and filter cards */
							<li
								data-post-id={post.id}
								data-title={post.data.title}
								data-pub-date={post.data.pubDate.valueOf()}
							>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
				<!-- Shown when Fuse.js finds no matches -->
				<p id="no-results" style="display:none; text-align:center; color:rgb(var(--gray)); padding:2rem 0;">
					No articles found. Try a different search term.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
<script>
	// Client-side sort + filter using Fuse.js fuzzy search and DOM reordering
	import Fuse from 'fuse.js';

	// Parse the serialized post data embedded in the page at build time
	const rawData = document.getElementById('search-data')?.textContent ?? '[]';
	const data: { id: string; title: string; description: string; tags: string[] }[] =
		JSON.parse(rawData);

	const fuse = new Fuse(data, {
		keys: ['title', 'description', 'tags'],
		threshold: 0.35, // 0 = exact match, 1 = match anything; 0.35 is a balanced default
		minMatchCharLength: 2,
	});

	const input = document.getElementById('search-input') as HTMLInputElement | null;
	const list = document.querySelector('ul')!;
	const noResults = document.getElementById('no-results')!;
	let currentSort = 'newest'; // default matches the server-side sort order

	// Reorder <li> elements in the DOM based on currentSort
	function sortArticles() {
		const items = Array.from(list.querySelectorAll<HTMLElement>('[data-post-id]'));
		items.sort((a, b) => {
			if (currentSort === 'newest')
				return Number(b.dataset.pubDate) - Number(a.dataset.pubDate);
			if (currentSort === 'oldest')
				return Number(a.dataset.pubDate) - Number(b.dataset.pubDate);
			if (currentSort === 'az')
				return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
			if (currentSort === 'za')
				return (b.dataset.title ?? '').localeCompare(a.dataset.title ?? '');
			return 0;
		});
		// Re-appending existing nodes is a standard DOM reorder — no elements are created
		items.forEach((item) => list.appendChild(item));
	}

	// Show/hide cards based on search query, then assign .featured to the first visible card
	// (.featured mirrors the CSS :first-child rules, but works correctly after sort + filter)
	function filterAndFeature(query: string) {
		const items = Array.from(list.querySelectorAll<HTMLElement>('[data-post-id]'));

		if (!query.trim()) {
			items.forEach((c) => (c.style.display = ''));
			noResults.style.display = 'none';
		} else {
			const hits = new Set(fuse.search(query).map((r) => r.item.id));
			let count = 0;
			items.forEach((card) => {
				const show = hits.has(card.dataset.postId ?? '');
				card.style.display = show ? '' : 'none';
				if (show) count++;
			});
			noResults.style.display = count === 0 ? '' : 'none';
		}

		// Assign .featured to the first visible card so the layout stays correct after reorder
		let featuredSet = false;
		items.forEach((card) => {
			card.classList.remove('featured');
			if (!featuredSet && card.style.display !== 'none') {
				card.classList.add('featured');
				featuredSet = true;
			}
		});
	}

	// Single entry point: always sort first, then filter+feature
	function render() {
		sortArticles();
		filterAndFeature(input?.value ?? '');
	}

	// Sort button clicks
	document.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.sort-btn').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			currentSort = btn.dataset.sort ?? 'newest';
			render();
		});
	});

	// Real-time search input
	input?.addEventListener('input', () => render());

	// Pre-fill from ?q= URL param when navigating here from another page, then render
	const q = new URLSearchParams(window.location.search).get('q') ?? '';
	if (q && input) input.value = q;
	render(); // run once on load to initialize featured card correctly
</script>
