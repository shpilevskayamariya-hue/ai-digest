---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to Little by Little</h1>
			<p>
				A gentle blog for mothers — on sleep, emotions, child health, and the everyday chaos of early parenthood.
			</p>
			<p>
				Whether you're up at 3am wondering if this is normal, or just looking for a quiet moment of reassurance — you're in the right place.
			</p>
			<p>
				<a href="/blog">Read the articles →</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
