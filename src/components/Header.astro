---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<!-- Search input — filtering logic lives in blog/index.astro; on other pages Enter navigates to /blog?q=... -->
		<div class="search-wrapper">
			<input
				id="search-input"
				type="search"
				placeholder="Search articles…"
				autocomplete="off"
				aria-label="Search articles"
			/>
		</div>
		<div class="social-links">
			<!-- TODO: replace href="#" with real Instagram URL -->
			<a href="#" target="_blank">
				<span class="sr-only">Instagram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.334 3.608 1.308.975.975 1.246 2.242 1.308 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.334 2.633-1.308 3.608-.975.975-2.242 1.246-3.608 1.308-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.334-3.608-1.308-.975-.975-1.246-2.242-1.308-3.608C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.062-1.366.334-2.633 1.308-3.608.975-.975 2.242-1.246 3.608-1.308C8.416 2.175 8.796 2.163 12 2.163zm0-2.163C8.741 0 8.332.014 7.052.072 5.197.157 3.547.842 2.268 2.121.99 3.399.305 5.049.22 6.904.014 8.184 0 8.593 0 12c0 3.407.014 3.816.072 5.096.085 1.855.77 3.505 2.049 4.784 1.278 1.278 2.928 1.963 4.783 2.048C8.184 23.986 8.593 24 12 24s3.816-.014 5.096-.072c1.855-.085 3.505-.77 4.784-2.049 1.278-1.278 1.963-2.928 2.048-4.783C23.986 15.816 24 15.407 24 12s-.014-3.816-.072-5.096c-.085-1.855-.77-3.505-2.049-4.784C20.601.842 18.951.157 17.096.072 15.816.014 15.407 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zm0 10.162a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
					></path></svg
				>
			</a>
			<!-- TODO: replace href="#" with real Twitter/X URL -->
			<a href="#" target="_blank">
				<span class="sr-only">Twitter / X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
					></path></svg
				>
			</a>
			<!-- TODO: replace href="#" with real Telegram URL -->
			<a href="#" target="_blank">
				<span class="sr-only">Telegram</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.447 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.12L7.17 13.667l-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.461c.537-.194 1.006.131.978.892z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.search-wrapper {
		flex: 1;
		display: flex;
		justify-content: center;
		padding: 0 1rem;
	}
	#search-input {
		width: 100%;
		max-width: 260px;
		padding: 0.35em 0.75em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 20px;
		font-size: 0.9em;
		color: rgb(var(--black));
		background: rgb(var(--gray-light), 0.4);
		outline: none;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}
	#search-input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 0 2px rgba(35, 55, 255, 0.15);
	}
	#search-input::placeholder {
		color: rgb(var(--gray));
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
		.search-wrapper {
			padding: 0 0.5rem;
		}
		#search-input {
			max-width: 140px;
			font-size: 0.8em;
		}
	}
</style>
<script>
	const input = document.getElementById('search-input') as HTMLInputElement | null;

	// On non-blog pages: Enter key navigates to /blog?q=...
	// On /blog: the blog index script handles real-time filtering instead
	input?.addEventListener('keydown', (e: KeyboardEvent) => {
		if (e.key === 'Enter' && !window.location.pathname.startsWith('/blog')) {
			window.location.href = `/blog?q=${encodeURIComponent((e.target as HTMLInputElement).value)}`;
		}
	});

	// Pre-fill the input if the page was loaded with a ?q= param (e.g. navigated from another page)
	const params = new URLSearchParams(window.location.search);
	const q = params.get('q');
	if (q && input) input.value = q;
</script>
